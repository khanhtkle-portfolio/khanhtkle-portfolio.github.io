      "from": 1,
      "to": 12,
      "domain": "finance",
      "title": {
        "vi": "Hạn mức tín dụng",
        "en": "Credit Limits"
      },
      "summary": {
        "vi": "Kế hoạch so với thực hiện về sản lượng, doanh thu, lợi nhuận theo từng pháp nhân, kèm các chỉ số tài chính ngân hàng dùng để xét hạn mức vay.",
        "en": "Plan vs. actual volume, revenue and profit by entity, alongside the financial ratios banks use to assess credit limits."
      },
      "owner": {
        "vi": "Phòng Tài chính – Kế toán",
        "en": "Finance & Accounting"
      },
      "refresh": {
        "vi": "Hằng tháng",
        "en": "Monthly"
      },
      "tags": {
        "vi": [
          "Kế hoạch vs thực hiện",
          "Ngân hàng",
          "Pháp nhân"
        ],
        "en": [
          "Plan vs actual",
          "Banking",
          "Entities"
        ]
      },
      "questions": {
        "vi": [
          "Pháp nhân nào đang vượt hoặc hụt so với kế hoạch?",
          "Các chỉ số tài chính có đáp ứng điều kiện của ngân hàng không?",
          "Hạn mức hiện tại có đủ cho kế hoạch sắp tới không?"
        ],
        "en": [
          "Which entity is ahead of or behind plan?",
          "Do the financial ratios meet the banks' conditions?",
          "Is the current limit enough for the coming plan?"
        ]
      }
    },
